# Puerto expuesto en el host
PORT=3000

# Segundos que se conservan los mensajes sin fijar y sin limpieza personalizada.
# 0 = nunca limpiar automáticamente. También se puede cambiar luego desde la UI (⚙️).
DEFAULT_RETENTION_SECONDS=86400

# Tamaño máximo por archivo subido, en MB.
MAX_UPLOAD_MB=200

# Si es "true", pide una passphrase compartida antes de poder usar el clipboard.
# Recomendado si vas a exponer esto fuera de tu red local.
AUTH_ENABLED=false
AUTH_PASSPHRASE=
